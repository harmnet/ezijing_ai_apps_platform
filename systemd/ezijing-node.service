[Unit]
Description=Ezijing AI Platform Node.js Service
After=network.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/opt/ezijing_ai_apps_platform
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 环境变量配置
Environment=NODE_ENV=production
# 从.env文件加载环境变量
EnvironmentFile=/opt/ezijing_ai_apps_platform/.env

# 系统资源限制
TimeoutStartSec=60
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target 