FROM node:16-alpine

# 设置工作目录
WORKDIR /app

# 创建nodejs目录
RUN mkdir -p /app/nodejs

# 复制依赖文件
COPY nodejs/package.json /app/package.json 2>/dev/null || echo "Node.js package.json not found"

# 安装依赖
RUN if [ -f "/app/package.json" ]; then \
    npm install; \
    else echo "No package.json found, skipping npm install"; \
    fi

# 复制源代码
COPY nodejs/ /app/

# 暴露端口
EXPOSE 3000

# 启动服务
CMD ["node", "app.js"] 