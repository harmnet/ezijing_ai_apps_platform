FROM python:3.9-slim

# 设置工作目录
WORKDIR /app

# 设置Python环境变量
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 确保backend目录存在
RUN mkdir -p /app/backend

# 尝试复制requirements.txt
COPY backend/requirements.txt /app/requirements.txt 2>/dev/null || echo "Backend requirements.txt not found"
COPY requirements.txt /app/requirements.txt 2>/dev/null || echo "Root requirements.txt not found"

# 安装Python依赖 - 检查文件是否存在
RUN if [ -f "/app/requirements.txt" ]; then \
    pip install --no-cache-dir -r /app/requirements.txt; \
    else echo "No requirements.txt found, skipping pip install"; \
    fi

# 创建uploads目录
RUN mkdir -p /app/uploads

# 复制后端代码
COPY backend/ /app/

# 暴露端口
EXPOSE 9000

# 设置启动命令
CMD ["python", "app.py"] 